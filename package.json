{
  "name": "tableau-lineage",
  "private": true,
  "version": "1.0.0",
  "description": "Free, open-source Tableau workbook auditor and lineage visualizer. Finds unused fields, duplicate calculations and performance problems, maps calculated-field lineage, and compares versions. Runs entirely in the browser.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://tableau-lineage.com",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test:core": "node --experimental-strip-types scripts/test-extractor.mts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:all": "npm run test:core && vitest run",
    "prerender": "node scripts/prerender.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^1.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@xmldom/xmldom": "^0.9.6",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10"
  },
  "author": "Sai Kiran Andey (https://www.linkedin.com/in/andeysaikiran/)",
  "funding": {
    "type": "individual",
    "url": "https://www.linkedin.com/in/andeysaikiran/"
  }
}
