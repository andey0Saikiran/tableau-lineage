  "bin": {
    "tableau-lineage-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "tableau",
    "twbx",
    "data-lineage",
    "calculated-fields",
    "business-intelligence",
    "claude",
